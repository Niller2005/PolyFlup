# =============================================================================
# RISK PROFILE PRESETS - Choose one and uncomment the section you want
# =============================================================================

# -----------------------------------------------------------------------------
# CONSERVATIVE (Recommended for beginners or small accounts <$500)
# -----------------------------------------------------------------------------
# BET_PERCENT=3.0
# MIN_EDGE=0.40
# CONTRARIAN_THRESHOLD=0.05
# MAX_SPREAD=0.12
# CONFIDENCE_SCALING_FACTOR=3.0
# MAX_SIZE=100.0
# MAX_SIZE_MODE=CAP
# STOP_LOSS_PRICE=0.40
# SCALE_IN_MULTIPLIER=1.0


# -----------------------------------------------------------------------------
# BALANCED (Default - Good balance of risk/reward for most users)
# -----------------------------------------------------------------------------
BET_PERCENT=5.0
MIN_EDGE=0.35              # Entry confidence >= 35% for Trend Following
CONTRARIAN_THRESHOLD=0.10  # Entry confidence <= 10% for Contrarian plays
MAX_SPREAD=0.15
CONFIDENCE_SCALING_FACTOR=5.0
MAX_SIZE=500.0             # Cap position size at 500 shares (use NONE for no cap)
STOP_LOSS_PRICE=0.30

# -----------------------------------------------------------------------------
# AGGRESSIVE (Higher risk/reward - for experienced traders with larger accounts)
# -----------------------------------------------------------------------------
# BET_PERCENT=8.0
# MIN_EDGE=0.32
# CONTRARIAN_THRESHOLD=0.08
# MAX_SPREAD=0.18
# CONFIDENCE_SCALING_FACTOR=7.0
# MAX_SIZE=1000.0
# MAX_SIZE_MODE=CAP
# STOP_LOSS_PRICE=0.20
# SCALE_IN_MULTIPLIER=2.0


# -----------------------------------------------------------------------------
# ULTRA AGGRESSIVE (Maximum risk - only for large accounts and high conviction)
# -----------------------------------------------------------------------------
# BET_PERCENT=12.0
# MIN_EDGE=0.30
# CONTRARIAN_THRESHOLD=0.12
# MAX_SPREAD=0.20
# CONFIDENCE_SCALING_FACTOR=10.0
# MAX_SIZE=2000.0
# MAX_SIZE_MODE=CAP
# STOP_LOSS_PRICE=0.10
# SCALE_IN_MULTIPLIER=2.5


# =============================================================================
# Common Settings (apply to all profiles)
# =============================================================================

WINDOW_DELAY_SEC=12      # Delay entry after event start
MAX_ENTRY_LATENESS_SEC=600 # Skip entry if > 10m late in a 15m window (5m markets scale to 200s; override with MAX_ENTRY_LATENESS_SEC_5M)
WINDOW_START_PRICE_BUFFER_PCT=0.05 # Allowed % deviation from window start price
MARKETS=BTC,ETH,XRP,SOL  # Markets to trade. Plain symbol = 15-minute market; add -5M for 5-minute markets, e.g. BTC,ETH,BTC-5M,ETH-5M
MARKETS_PAPER=BTC,ETH,XRP,SOL,BTC-5M,ETH-5M  # Used instead of MARKETS with --paper

# Atomic Hedging Configuration
COMBINED_PRICE_THRESHOLD=0.97        # Max combined ask price searched for a taker pair (net edge after fees must still be >= MIN_NET_EDGE)
MIN_NET_EDGE=0.01                    # Min guaranteed profit per share AFTER fees to open a pair (1¢)
ENABLE_MAKER_PAIR=YES                # If no taker pair qualifies, rest POST_ONLY bids on both legs (no fees)
MAKER_PAIR_PRICE_BAND=0.20            # Only quote while both bids are in [0.20, 0.80]
MAKER_PAIR_IMPROVE_TICKS=0           # Ticks above best bid to quote (0 = join queue)
TAKER_FEE_RATE=0.07                  # Crypto taker fee rate: fee = shares*rate*p*(1-p)

# Risk profile at startup: conservative | balanced | aggressive | custom (= the values in this file).
# Switch live in the TUI with keys 1/2/3/0 (see docs/RISK_PROFILES.md)
RISK_PROFILE=balanced

# Exposure-aware sizing
MAX_EXPOSURE_PERCENT=50              # Open positions + entries in flight <= this % of equity (cash + exposure)
SIZE_FROM_AVAILABLE_CASH=YES         # BET_PERCENT applies to cash not already committed (entries shrink as cash is used)

# Kelly position sizing (replaces flat BET_PERCENT when YES)
KELLY_SIZING=NO
KELLY_FRACTION=0.25                  # Fraction of full Kelly (estimates are noisy)
KELLY_MAX_FRACTION=0.08              # Hard cap per position, fraction of bankroll
KELLY_LEG_FAIL_RATE=0.30             # Prior: share of pairs that leg out. Measure in paper mode; break-even is ~20%
KELLY_LEG_LOSS=0.04                  # Loss/share when a pair legs out
KELLY_PROB_HAIRCUT=0.02              # Subtracted from late-window win probability before sizing

# Paper trading (uv run polyflup.py --paper)
PAPER_STARTING_BALANCE=1000          # Starting pUSD for the simulated account
PAPER_MAKER_FILL_MODE=cross          # cross = conservative, touch = optimistic maker fills

ENABLE_TRAILING=YES                  # After one leg fills, re-quote the other at best bid (never above 1-filled-MIN_NET_EDGE)
TRAIL_MAX_TICKS=2                    # Max ticks above best bid it may escalate to over the fill timeout
TRAIL_MIN_REPRICE_SECONDS=5
LEGOUT_HOLD_SHARE=0.25               # A/B: share of one-leg fills held to resolution instead of sold (recorded as resolution='hold_ab')
TRAIL_MAX_LOCK_LOSS=0.03             # Second leg may be quoted up to this far above break-even to complete a pair (a leg-out costs ~0.14/sh)

# Late-window conviction mode (leading side near close; uses Chainlink feed when API creds exist)
LATE_WINDOW_ENABLED=YES              # Evaluate + log to shadow_signals (no orders)
LATE_WINDOW_LIVE=NO                  # Place real orders - enable only after reviewing analyze_strategy.py
LATE_WINDOW_SECONDS=90               # Evaluate in the last N seconds of a window
LATE_WINDOW_MIN_EV=0.015             # Min net EV/share after taker fee
LATE_WINDOW_MAX_DISAGREEMENT=0.15   # Skip when ask is this far below our probability (market knows better)
LATE_WINDOW_MIN_DISTANCE_PCT=0.02    # Skip if spot is within this % of strike (doubled when using Binance)
LATE_WINDOW_BET_USD=5.0
LATE_WINDOW_EVAL_INTERVAL=10         # Seconds between evaluations per market
HEDGE_FILL_TIMEOUT_SECONDS=120       # Timeout for both orders to fill (default: 120s)
HEDGE_POLL_INTERVAL_SECONDS=5        # Check fill status every N seconds (default: 5s)

# Pre-Settlement Exit Strategy
ENABLE_PRE_SETTLEMENT_EXIT=YES       # Exit losing side early if confidence > threshold (unhedged positions only unless PRE_SETTLEMENT_EXIT_HEDGED=YES)
PRE_SETTLEMENT_EXIT_HEDGED=NO        # Selling the losing leg of a hedged pair gave up ~$99 vs holding; keep NO
PRE_SETTLEMENT_MIN_CONFIDENCE=0.80   # Min confidence to trigger early exit (80%)
PRE_SETTLEMENT_EXIT_SECONDS=180      # Start checking at T-180s before resolution
PRE_SETTLEMENT_CHECK_INTERVAL=30     # Check every N seconds (default: 30s)

# Emergency Sell Timing (Time-Aware Liquidation)
EMERGENCY_SELL_ENABLE_PROGRESSIVE=YES # Enable time-aware pricing strategy
EMERGENCY_SELL_WAIT_SHORT=5          # Wait time for aggressive mode (<300s remaining)
EMERGENCY_SELL_WAIT_MEDIUM=8         # Wait time for balanced mode (300-600s)
EMERGENCY_SELL_WAIT_LONG=10          # Wait time for patient mode (>600s)
EMERGENCY_SELL_FALLBACK_PRICE=0.10   # Final fallback price if all else fails
EMERGENCY_SELL_HOLD_IF_WINNING=YES   # Hold small positions if still winning
EMERGENCY_SELL_MIN_PROFIT_CENTS=2    # Min profit in cents to consider "winning"

# Position Scaling (Deprecated - not used with atomic hedging)

# Wallet & API Keys
PROXY_PK=0xYOUR_PRIVATE_KEY_HERE    # Polygon wallet private key (EOA - needs small POL balance for gas if fallback used)
FUNDER_PROXY=                       # Polymarket proxy/Safe/deposit wallet address holding your pUSD
SIGNATURE_TYPE=2                    # 0=EOA, 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE, 3=POLY_1271 (deposit wallet)
POLYGON_RPC=https://polygon-rpc.com # RPC used to read your pUSD balance
# Bot fill automaticaly
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Polymarket Builder API (for gasless CTF operations)
# Apply at: https://polymarket.com/developers
# IMPORTANT: These are DIFFERENT from trading API credentials above
POLY_BUILDER_API_KEY=               # Builder API key (from Builder Profile)
POLY_BUILDER_SECRET=                # Builder secret (from Builder Profile)
POLY_BUILDER_PASSPHRASE=            # Builder passphrase (from Builder Profile)
ENABLE_RELAYER_CLIENT=YES           # Use gasless relayer (YES) or manual Web3 (NO)
                                    # NOTE: If relayer unavailable, falls back to Web3 (requires POL for gas)

# ADX Filter Configuration
ADX=NO
ADX_INTERVAL=15m
ADX_PERIOD=10

# Enhanced Binance Integration (Price Action Analysis)
ENABLE_MOMENTUM_FILTER=YES    # Use Binance price momentum (velocity, acceleration, RSI)
ENABLE_ORDER_FLOW=YES          # Analyze Binance order flow (buy/sell pressure)
ENABLE_DIVERGENCE=YES          # Detect Polymarket vs Binance price divergence
ENABLE_VWM=YES                 # Volume-weighted momentum indicators
MOMENTUM_LOOKBACK_MINUTES=15   # Minutes to analyze for momentum (default: 15)

# Confidence Calculation Method
BAYESIAN_CONFIDENCE=NO          # Use Bayesian confidence calculation (NO=Additive, YES=Bayesian)
                                # Keep NO initially to collect A/B testing data, then switch if Bayesian performs better

# Legacy External Trend Filter (BFXD)
ENABLE_BFXD=NO                 # Enable external BFXD trend filter (mostly redundant with Binance integration)
BFXD_URL=                      # External BFXD service URL (only used if ENABLE_BFXD=YES)

# External Services
DISCORD_WEBHOOK=

# Production Server Configuration (for sync tools)
PRODUCTION_SSH_HOST=root@your-server-ip
PRODUCTION_REMOTE_PATH=/path/to/polyastra
